root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Front (formaté par Prettier) et fichiers de config : 2 espaces
# Le PHP reste à 4 espaces (norme PSR-12 appliquée par Pint)
[*.{blade.php,css,js,json,yml,yaml}]
indent_size = 2
